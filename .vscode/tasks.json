
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "shell",
            "command": "mkdir -p \"${workspaceFolder}/bin\" && clang++ -std=c++17 \"${file}\" -o \"${workspaceFolder}/bin/${fileBasenameNoExtension}\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run C++",
            "type": "shell",
            "command": "\"${workspaceFolder}/bin/${fileBasenameNoExtension}\"",
            "dependsOn": "Build C++",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
